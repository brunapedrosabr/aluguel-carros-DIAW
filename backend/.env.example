# Copie para backend/.env e preencha com os dados do seu projeto no Supabase.
# Supabase > Project Settings > Database > Connect > "Session pooler" (funciona em redes IPv4).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO

# Pelo menos 32 caracteres. Gere um valor aleatório e não versione.
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria-com-32-ou-mais-caracteres

# Opcionais
# DB_SCHEMA=aluguel
# CORS_ORIGENS=http://localhost:5173
# SEED_DEMO=true
